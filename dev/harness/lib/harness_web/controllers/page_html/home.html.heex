<Layouts.app flash={@flash}>
  <div class="space-y-6 py-10">
    <h1 class="text-3xl font-bold">Wiretap harness</h1>
    <p class="opacity-80">
      A host Phoenix app for developing and demoing the wiretap library — it generates real
      Phoenix.PubSub traffic (including the bug classes wiretap exists to catch) and never
      knows it is being observed.
    </p>

    <ul class="grid gap-4 lg:grid-cols-2 items-start">
      <li class="rounded border p-4 space-y-1">
        <a href="/demo" class="link font-semibold">ATC console</a>
        <p class="text-sm opacity-70">
          Track flights that enter and land on their own (topics that come and go), leak
          subscriptions on purpose, check the registry truth, and run capture sessions —
          all on one page.
        </p>
      </li>
      <li class="rounded border p-4 space-y-1">
        <a href="/dashboard/wiretap" class="link font-semibold">Roll Call (LiveDashboard)</a>
        <p class="text-sm opacity-70">
          Wiretap's LiveDashboard page: every topic on Harness.PubSub with subscriber counts
          and labeled pids, searchable and sortable. Open it next to the console and watch
          the topic list churn.
        </p>
      </li>
    </ul>

    <div class="rounded border p-4 space-y-1">
      <h2 class="font-semibold">Headless, from iex</h2>
      <pre class="font-mono text-sm overflow-x-auto" phx-no-curly-interpolation><code>{:ok, s} = Wiretap.watch(Harness.PubSub, interval_ms: 250)
Wiretap.events(s)
Wiretap.snapshot(Harness.PubSub)</code></pre>
    </div>
  </div>
</Layouts.app>
